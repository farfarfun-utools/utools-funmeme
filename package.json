{
  "name": "@farfarfun/utools-funmeme",
  "funbuild": {
    "build": "sh build.sh"
  },
  "version": "0.1.0",
  "description": "趣图生花 FunMeme：离线可用、按需联网的 uTools 表情包与斗图工作室，支持内置精选梗图、Imgflip/GIPHY/Tenor/自定义接口在线斗图、10 款矢量手绘模板加字改图、8 款文字大字报表情、Emoji 贴纸与颜文字库",
  "license": "MIT",
  "homepage": "https://farfarfun.github.io/packages/utools-funmeme/",
  "repository": {
    "type": "git",
    "url": "https://github.com/farfarfun-utools/utools-funmeme.git"
  },
  "bugs": {
    "url": "https://github.com/farfarfun-utools/utools-funmeme/issues"
  },
  "keywords": [
    "utools",
    "utools-plugin",
    "funmeme",
    "meme",
    "emoji",
    "kaomoji",
    "sticker",
    "meme-maker",
    "text-meme",
    "vue3",
    "typescript",
    "farfarfun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.12"
  }
}
